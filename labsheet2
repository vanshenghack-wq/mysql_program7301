-- 11. Update city/address of a student
UPDATE Student_Details SET Address = 'Gurgaon' WHERE Student_ID = 1;

-- 12. Update salary of an employee
UPDATE Employee SET Salary = 50000 WHERE Emp_ID = 101;

-- 13. Increase salary of all employees by 10%
UPDATE Employee SET Salary = Salary * 1.10;

-- 14. Increase price of all products by 5%
UPDATE Product SET Price = Price * 1.05;

-- 15. Change course of a student
UPDATE Student_Details SET Course = 'Data Science' WHERE Student_ID = 2;

-- 16. Update department of an employee
UPDATE Employee SET Department = 'Finance' WHERE Emp_ID = 102;

-- 17. Update city of all students from Meerut to Delhi
UPDATE Student_Details SET Address = 'Delhi' WHERE Address = 'Meerut';

-- 19. Update multiple columns simultaneously
UPDATE Student_Details SET Age = 22, Course = 'M.Tech' WHERE Student_ID = 3;

-- 20. Delete particular student record
DELETE FROM Student_Details WHERE Student_ID = 10;

-- 21. Delete all students belonging to a particular city
DELETE FROM Student_Details WHERE Address = 'Kanpur';

-- 22. Delete employees whose salary is below a specified amount
DELETE FROM Employee WHERE Salary < 40000;

-- 23. Delete products whose quantity is zero
DELETE FROM Product WHERE Quantity = 0;

-- 24. Delete records using AND/OR
DELETE FROM Student_Details WHERE Age > 22 AND Address = 'Delhi';

